# learning-lab: Open WebUI settings (NAMES + non-secret defaults). Copy to .env.
# Secrets go in .env only; .env is gitignored.
#
# Open WebUI copies these values into its database on first boot and reads them
# from there afterwards (ENABLE_PERSISTENT_CONFIG=True by default). Set them
# before the first `docker compose up`; later edits here are ignored, change the
# setting in the admin UI instead. WEBUI_SECRET_KEY is read from the env every boot.

# --- Secrets -------------------------------------------------------------------
WEBUI_SECRET_KEY=                # openssl rand -hex 32; signs session tokens
OPENAI_API_KEY=                  # OpenRouter key (sk-or-...) with a monthly credit limit

# --- Model provider: OpenRouter via the OpenAI-compatible API ------------------
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
ENABLE_OLLAMA_API=False
ENABLE_BASE_MODELS_CACHE=True    # don't refetch OpenRouter's model list per request

# --- Public URL (Tailscale Funnel) ---------------------------------------------
# Leave WEBUI_URL and CORS_ALLOW_ORIGIN at http://localhost:3000 for a local run.
WEBUI_URL=https://scandium.dinosaur-cloud.ts.net:10000
CORS_ALLOW_ORIGIN=https://scandium.dinosaur-cloud.ts.net:10000
WEBUI_SESSION_COOKIE_SECURE=True
WEBUI_AUTH_COOKIE_SECURE=True

# --- Branding ------------------------------------------------------------------
# Shown on the login page and the tab. This version appends " (Open WebUI)".
WEBUI_NAME=Learning Lab

# --- Accounts ------------------------------------------------------------------
# First registered user becomes admin (scripts/seed.py does this). Anyone can
# sign up afterwards; they wait as "pending" until an admin approves them in
# Admin > Users. Admins can read all chats by default
# (ENABLE_ADMIN_CHAT_ACCESS); tell the students.
ENABLE_SIGNUP=True
DEFAULT_USER_ROLE=pending
ENABLE_COMMUNITY_SHARING=False
ENABLE_VERSION_UPDATE_CHECK=False

# --- Memory (the model writes per-user memories via builtin tools) -------------
# The learning plan lives in memory; the default 2000-char budget truncates it.
ENABLE_MEMORIES=True
MEMORIES_CONTEXT_CHAR_LIMIT=8000
MEMORIES_USER_CHAR_LIMIT=8000

# --- Only the tutor ------------------------------------------------------------
# No chat controls, user system prompt, parameter tweaks, multi-model chats or
# unsaved chats. No side features that route around the preset (code
# interpreter, notes, arena, web search, image generation, channels, automations).
# Workspace editing is off for users by default.
USER_PERMISSIONS_CHAT_CONTROLS=False
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=False
USER_PERMISSIONS_CHAT_PARAMS=False
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=False
USER_PERMISSIONS_CHAT_TEMPORARY=False
USER_PERMISSIONS_CHAT_SHARE=False
ENABLE_FOLLOW_UP_GENERATION=False  # suggested replies were leaking the answer
ENABLE_CODE_INTERPRETER=False
ENABLE_NOTES=False
ENABLE_EVALUATION_ARENA_MODELS=False
ENABLE_WEB_SEARCH=False
ENABLE_IMAGE_GENERATION=False
ENABLE_CHANNELS=False
ENABLE_AUTOMATIONS=False

# --- scripts/seed.py -----------------------------------------------------------
# Passwords are prompted for when unset. STUDENT_* is an optional pre-approved
# account for testing; real students sign up themselves.
TUTOR_MODEL=~z-ai/glm-flash-latest
# Read-aloud voice: an OpenRouter TTS model and one of its voices; leave TTS_MODEL empty for the browser's own voices.
TTS_MODEL=hexgrad/kokoro-82m
TTS_VOICE=af_heart
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STUDENT_NAME=
STUDENT_EMAIL=
STUDENT_PASSWORD=
